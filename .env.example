# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

# Public (safe to expose to the browser — sent to the client):
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser —
# this bypasses Row Level Security, so a leak is a full database compromise.
# Used only by lib/supabase/admin.ts (committee invites, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email (SendGrid Web API). SERVER-ONLY -- never prefix any of these with
# NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# SendGrid API key with Mail Send permission.
SENDGRID_API_KEY=your-sendgrid-api-key

# Delivery switch. "live" actually sends; "log" renders the message and records
# it in email_log without sending. Anything else, or unset, is treated as "log",
# so a misconfigured environment stays silent rather than mailing real people.
EMAIL_DELIVERY=log

# The sending identity. EMAIL_FROM must be an address verified in SendGrid.
# Reply-To is NOT set here -- it comes from email_config.manager_notification_address.
EMAIL_FROM=no-reply@washingtonwine.org
EMAIL_FROM_NAME="WRAC Research Portal"

# Base URL used in email bodies to link people back into the portal.
# Development: http://localhost:3000
PORTAL_URL=https://wrac-portal.vercel.app

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# SERVER-ONLY shared secret for /api/cron/daily (the daily sweep in
# vercel.json, 15:00 UTC = 07:00 PST / 08:00 PDT). Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>` once the variable is
# set on the project; the route refuses every request when it is unset or
# empty, so a misconfigured environment runs no jobs rather than exposing an
# open mail-sending endpoint. Use a long random value (32+ characters), e.g.
#   openssl rand -hex 32
CRON_SECRET=a-long-random-string
