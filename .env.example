# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

# Public (safe to expose to the browser — sent to the client):
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser —
# this bypasses Row Level Security, so a leak is a full database compromise.
# Used only by lib/supabase/admin.ts (committee invites, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
